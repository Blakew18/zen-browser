# Initialize settings sync before UI startup so it can schedule its first cycle.
category browser-before-ui-startup resource:///modules/zen/ZenSync.sys.mjs ZenSync.init

# Tear down the timer / loopback socket on shutdown.
category browser-quit-application-granted resource:///modules/zen/ZenSync.sys.mjs ZenSync.uninit
