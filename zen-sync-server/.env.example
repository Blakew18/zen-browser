# Copy to .env and fill in. All configuration is via environment variables.

# --- OIDC / Authentik ------------------------------------------------------
# The `iss` value your Authentik provider stamps into access tokens. Find it in
# Authentik under: Applications > Providers > (your provider) > "OpenID
# Configuration Issuer". Typically:
#   https://auth.example.com/application/o/<application-slug>/
OIDC_ISSUER=https://auth.example.com/application/o/zen-sync/

# Optional: skip discovery by pinning the JWKS URL directly.
# OIDC_JWKS_URI=https://auth.example.com/application/o/zen-sync/jwks/

# The audience to require in tokens. For Authentik this is the application's
# Client ID. Comma-separated to accept more than one. Leave blank to skip the
# audience check (not recommended).
OIDC_AUDIENCE=your-authentik-client-id

# --- Server ----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
MAX_BLOB_BYTES=1000000

# --- At-rest encryption (optional) -----------------------------------------
# base64 of exactly 32 random bytes. Generate with:
#   openssl rand -base64 32
# If set, every stored blob is encrypted with AES-256-GCM. If you lose this key
# you lose the data, so back it up.
# ENCRYPTION_KEY=
